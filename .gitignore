*.pyc
.pytest_cache/
.DS_Store
paper/*.aux
paper/*.log
paper/*.out
paper/*.blg
paper/*.spl
*.aux
*.log
*.out

# Tracked-changes intermediates. _marked.tex IS committed (the gates diff it against the
# manuscript, which is how a stale tracked deliverable is caught); the rest are derived.
paper/_marked.pdf
paper/_marked.aux
paper/_marked.log
paper/_marked.out
paper/_marked.bbl
paper/_marked.blg
paper/_marked.spl

# Peer-review correspondence. These are the submission package, not the reproducibility
# archive: they contain the referees' verbatim comments, the editor's name and the submission
# ID, and must never be published to GitHub or archived on Zenodo. They stay on disk.
paper/reviewer_comments_verbatim.txt
paper/response_to_reviewers.tex
paper/response_to_reviewers.pdf
paper/response_to_editor.tex
paper/response_to_editor.pdf
paper/manuscript_round1_baseline.tex
paper/_marked.tex
